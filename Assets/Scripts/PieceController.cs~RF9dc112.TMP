using UnityEngine;
using UnityEngine.InputSystem;

public class PieceController : MonoBehaviour
{
    [SerializeField] private float moveSpeed = 5f;

    private Rigidbody2D rb;
    private bool isActive = true;
    private bool hasBeenDropped = false;
    private bool hasSettled = false;

    private PieceSpawner spawner;

    private void Awake()
    {
        rb = GetComponent<Rigidbody2D>();
        rb.gravityScale = 0f;

        float randomAngle = Random.Range(0f, 360f);
        transform.rotation = Quaternion.Euler(0f, 0f, randomAngle);
    }

    private void Update()
    {
        if (!isActive)
            return;

        Move();

        if (Keyboard.current != null &&
            Keyboard.current.spaceKey.wasPressedThisFrame)
        {
            Drop();
        }
    }

    private void Move()
    {
        float horizontal = 0f;

        if (Keyboard.current != null)
        {
            if (Keyboard.current.aKey.isPressed ||
                Keyboard.current.leftArrowKey.isPressed)
            {
                horizontal = -1f;
            }

            if (Keyboard.current.dKey.isPressed ||
                Keyboard.current.rightArrowKey.isPressed)
            {
                horizontal = 1f;
            }
        }

        Vector2 velocity = rb.linearVelocity;
        velocity.x = horizontal * moveSpeed;
        rb.linearVelocity = velocity;
    }

    private void Drop()
    {
        if (!isActive)
            return;

        isActive = false;
        hasBeenDropped = true;

        rb.gravityScale = 1f;
    }

    private float settleTimer = 0f;
    [SerializeField] private float settleTime = 0.5f;

    private void OnCollisionStay2D(Collision2D collision)
    {
        if (isActive)
            return;

        // Wait until the piece has been in contact for a short time
        // and is moving slowly enough to be considered settled.
        if (rb.linearVelocity.magnitude < 0.1f &&
            Mathf.Abs(rb.angularVelocity) < 5f)
        {
            settleTimer += Time.fixedDeltaTime;

            if (settleTimer >= settleTime)
            {
                Settle();
            }
        }
        else
        {
            settleTimer = 0f;
        }
    }

    private void Settle()
    {
        if (hasSettled)
            return;

        hasSettled = true;
        enabled = false;

        Debug.Log("Piece has settled: " + gameObject.name);

        if (spawner != null)
        {
            spawner.PieceSettled();
        }
    }

    public void SetSpawner(PieceSpawner pieceSpawner)
    {
        spawner = pieceSpawner;
    }
}